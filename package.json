{
  "name": "YanMusic",
  "version": "1.2.3",
  "description": "YanMusic desktop client.",
  "license": "GPL-3.0",
  "author": {
    "name": "Yan",
    "email": "a18821657632@outlook.com"
  },
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && electron-builder",
    "build:win": "cd server && npm install --omit=dev && cd .. && vue-tsc --noEmit && vite build && electron-builder --win --x64",
    "build:mac": "cd server && npm install --omit=dev && cd .. && vue-tsc --noEmit && vite build && electron-builder --mac",
    "build:linux": "cd server && npm install --omit=dev && cd .. && vue-tsc --noEmit && vite build && electron-builder --linux",
    "preview": "vite preview",
    "test": "node --test tests/*.test.ts",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx",
    "analyze": "ANALYZE_BUNDLE=1 vite build",
    "format": "prettier --write \"src/**/*.{vue,ts,js,json}\" \"vite.config.mts\" \"tsconfig*.json\""
  },
  "dependencies": {
    "@iconify/icons-tabler": "^1.2.95",
    "@iconify/types": "^2.0.0",
    "@iconify/vue": "^5.0.3",
    "@internationalized/date": "3.12.4",
    "@vue/runtime-core": "^3.5.43",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.20.0",
    "crypto": "^1.0.1",
    "crypto-js": "^4.2.0",
    "dompurify": "^3.4.15",
    "electron-audio-loopback": "^1.0.6",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "font-list": "^2.1.0",
    "marked": "^18.0.13",
    "node-stream-zip": "^1.15.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.5",
    "semver": "^7.8.5",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4",
    "yzs-keep-alive-v3": "^0.1.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.9.1",
    "@types/semver": "^7.7.1",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.6.1",
    "electron": "43.7.3",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vue-tsc": "^3.3.11"
  },
  "build": {
    "appId": "com.mmlwryan.yanmusic",
    "productName": "YanMusic",
    "publish": [
      {
        "provider": "github",
        "owner": "MmlwrYan",
        "repo": "YanMusic"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "protocols": [
      {
        "name": "yanmusic Share",
        "schemes": [
          "yanmusic"
        ]
      }
    ],
    "afterPack": "./build/afterPack.js",
    "files": [
      "dist",
      "dist-electron"
    ],
    "asarUnpack": [
      "**/*.node",
      "server/**"
    ],
    "extraResources": [
      {
        "from": "native/yan-media-controls/yan-media-controls.node",
        "to": "native/yan-media-controls.node",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "native/yan-mpv-player/yan-mpv-player.node",
        "to": "native/yan-mpv-player.node",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "native/yan-storage/yan-storage.node",
        "to": "native/yan-storage.node",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "native/yan-spectrum-capture/yan-spectrum-capture.node",
        "to": "native/yan-spectrum-capture.node",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/mpv",
        "to": "mpv",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icons",
        "to": "icons",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "CHANGELOG.md",
        "to": "CHANGELOG.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "LICENSES",
        "to": "LICENSES",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "server/module",
        "to": "server/module",
        "filter": [
          "**/*.js"
        ]
      },
      {
        "from": "server/util",
        "to": "server/util",
        "filter": [
          "**/*.js",
          "**/*.json"
        ]
      },
      {
        "from": "server/node_modules",
        "to": "server/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "icons/icon.icns",
      "category": "public.app-category.music",
      "target": [
        "zip",
        "dmg"
      ]
    },
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icons/linux_256x256.png",
      "target": [
        "AppImage",
        "deb",
        "pacman",
        "rpm",
        "tar.gz"
      ]
    },
    "deb": {
      "depends": [
        "libasound2",
        "libmpv2 | libmpv1"
      ]
    },
    "pacman": {
      "fpm": [
        "-d",
        "mpv"
      ]
    },
    "rpm": {
      "depends": [
        "mpv-libs"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "include": "build/installer.nsh",
      "buildUniversalInstaller": false,
      "artifactName": "${productName}-${version}-Windows-Setup-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}",
      "backgroundColor": "#ffffff",
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 180,
          "y": 170,
          "type": "file"
        },
        {
          "x": 480,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller"
    ],
    "ignoredBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  }
}
